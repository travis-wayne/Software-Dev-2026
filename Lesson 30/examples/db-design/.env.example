# ── Neon PostgreSQL ───────────────────────────────────────────────
# 💡 You can REUSE the same Neon database from Lesson 28!
# Get a free database at https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=DATABASE_URL=postgresql://neondb_owner:npg_rLMlb51ZGHJW@ep-rapid-queen-abscvhe7-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Server port ───────────────────────────────────────────────────
# Defaults to 3000 if not set
PORT=3000

# ─────────────────────────────────────────────────────────────────
# SETUP NOTES:
#   1. Create your Neon project at https://neon.tech
#   2. Copy the connection string into DATABASE_URL above
#   3. Run schema.sql in the Neon SQL Editor to create the tables
#   4. Run: npm install
#   5. Run: npm start
#
#   If DATABASE_URL is left blank the server will automatically
#   use a SQLite in-memory database (no setup required).
# ─────────────────────────────────────────────────────────────────
