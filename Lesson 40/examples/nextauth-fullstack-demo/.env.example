# NextAuth Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="lesson_40_super_secret_development_key_change_in_production_123456789"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Neon PostgreSQL Connection String
# If left empty, the app automatically falls back to an offline in-memory SQLite database!
