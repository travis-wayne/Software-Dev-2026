# Lesson 28 — SQL Basics + PostgreSQL  |  Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
# ➜ Sign up free at https://neon.tech
# ➜ Create a project → copy the connection string from the dashboard
# ➜ Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# If this variable is NOT set, the server automatically falls back to
# an in-memory SQLite database (perfect for offline learning).
DATABASE_URL=

# Express server port (default: 3000)
PORT=3000
