# Lesson 42 — AWS S3 Configuration Example
# If AWS_ACCESS_KEY_ID or AWS_S3_BUCKET is left blank or commented out, the server automatically uses the Offline Mock S3 Client for zero-setup local testing!

PORT=3003
AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIA_EXAMPLE_KEY"
# AWS_SECRET_ACCESS_KEY="EXAMPLE_SECRET_KEY"
# AWS_S3_BUCKET="my-lesson42-demo-bucket"

# Supabase Storage (zero credit card required!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-from-project-settings
SUPABASE_BUCKET=lesson-42-uploads
