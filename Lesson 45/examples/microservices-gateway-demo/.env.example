# API Gateway
GATEWAY_PORT=3009
JWT_SECRET=lesson45_gateway_secret

# Service URLs (docker-compose uses service names, local uses localhost)
USER_SERVICE_URL=http://localhost:3010
PRODUCT_SERVICE_URL=http://localhost:3011
ORDER_SERVICE_URL=http://localhost:3012

# User Service DB — set for Neon PostgreSQL, leave empty for in-memory
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
