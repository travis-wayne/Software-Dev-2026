// ============================================================
// DATABASE CONFIGURATION
// Default: Neon PostgreSQL (cloud) — set DATABASE_URL in .env
// For local offline dev without Neon: uncomment SQLite block below
// and comment out the postgresql block
// ============================================================

// --- OPTION A: Neon / Supabase / Railway PostgreSQL (Default) ---
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")    // Pooled connection URL (for app queries)
  directUrl = env("DIRECT_URL")     // Direct connection URL (for migrations only!)
}

// --- OPTION B: Local SQLite (offline fallback) ---
// datasource db {
//   provider = "sqlite"
//   url      = "file:./dev.db"
// }

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("USER") // In PostgreSQL, this can be modeled as enum Role { USER ADMIN }
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email]) // Index for high-speed authentication lookups!
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total     Float
  status    String      @default("COMPLETED")
  items     OrderItem[]
  createdAt DateTime    @default(now())

  @@index([userId]) // Index foreign key column to optimize relational JOIN performance!
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Float

  @@index([orderId])
  @@index([productId])
}

model Product {
  id          Int         @id @default(autoincrement())
  sku         String      @unique
  name        String
  description String?
  price       Float
  stock       Int         @default(100)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}
